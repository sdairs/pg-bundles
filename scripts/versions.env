# Pinned sources for pg-bundles. Sourced by scripts/build.sh (bash).
#
# Every source is pinned by version AND sha256. build.sh refuses to use a
# download whose hash does not match.
#
# scripts/check-updates.py finds newer releases of PostgreSQL, pg_clickhouse,
# OpenSSL, curl, lz4, zstd, zlib and util-linux, verifies the new file against
# the upstream-published hash and rewrites the <NAME>_VERSION and
# <NAME>_SHA256 lines here (the update workflow runs it weekly), so keep each
# of those assignments on one line of its own. libedit, ncurses and musl are
# bumped by hand: download the new file, check its signature, and update both
# lines together.
#
# Format: <NAME>_VERSION, <NAME>_URL, <NAME>_SHA256. A _URL may list several
# space-separated mirrors of the same file; they are tried in order.

# PostgreSQL: one entry per supported major, latest minor of each (from
# ftp.postgresql.org; hashes match the upstream .sha256 files).
# PG_MAJOR selects which one a build uses (default: the newest).
PG_MAJORS="17 18"
PG17_VERSION=17.12
PG17_SHA256=9cf136a703d8ee2f83465c43be4e9e8e7930c82b0bfba13be7e2537be769ac55
PG18_VERSION=18.7
PG18_SHA256=441dfae4280cae3e0425e5f876f80559fb0731c140f1aae22b3e5a54d0411bfd

PG_MAJOR="${PG_MAJOR:-18}"
_pgv="PG${PG_MAJOR}_VERSION"; _pgs="PG${PG_MAJOR}_SHA256"
PG_VERSION="${!_pgv:-}"; PG_SHA256="${!_pgs:-}"
unset _pgv _pgs
if [ -z "$PG_VERSION" ]; then
  echo "error: unsupported PG_MAJOR=$PG_MAJOR (supported: $PG_MAJORS)" >&2
  return 1 2>/dev/null || exit 1
fi
PG_URL="https://ftp.postgresql.org/pub/source/v${PG_VERSION}/postgresql-${PG_VERSION}.tar.bz2"

# pg_clickhouse, latest release: the PGXN distribution zip, which includes the
# vendored pg-clickhouse-c submodule. PGXN publishes its sha1 in META.json.
# The GitHub release carries the same file for most versions (byte-identical
# for 0.11.0; 0.11.1 has no release asset), so it is listed as a mirror.
PGCH_VERSION=0.11.1
PGCH_URL="https://api.pgxn.org/dist/pg_clickhouse/${PGCH_VERSION}/pg_clickhouse-${PGCH_VERSION}.zip https://github.com/ClickHouse/pg_clickhouse/releases/download/v${PGCH_VERSION}/pg_clickhouse-${PGCH_VERSION}.zip"
PGCH_SHA256=2c8770754093533e42a4f8f4c3e96f3038900ee38a377489be16573e0f3d0e9f

# OpenSSL 3.5 is the current 3.x LTS (supported to 2030). 3.6.x is newer but
# goes EOL in 2026-11; 4.x is a new major and not targeted here.
OPENSSL_VERSION=3.5.9
OPENSSL_URL="https://github.com/openssl/openssl/releases/download/openssl-${OPENSSL_VERSION}/openssl-${OPENSSL_VERSION}.tar.gz"
OPENSSL_SHA256=603f5602e2eef00d77fbd429d34dcd5822bb301757a1bc9cdb24c670f1eb859a

CURL_VERSION=8.23.0
# curl.se, then the same file from the GitHub release (tag curl-8_23_0).
CURL_URL="https://curl.se/download/curl-${CURL_VERSION}.tar.xz https://github.com/curl/curl/releases/download/curl-${CURL_VERSION//./_}/curl-${CURL_VERSION}.tar.xz"
CURL_SHA256=8dadd7d2536a314f982ad05a651b713f426bf7d02cc2c76cffb9796f2218e6c5

LZ4_VERSION=1.11.1
LZ4_URL="https://github.com/lz4/lz4/releases/download/v${LZ4_VERSION}/lz4-${LZ4_VERSION}.tar.gz"
LZ4_SHA256=683fed08a844ad012196381e40badf80c0bbe4962959761416d41c9e67d77ec7

ZSTD_VERSION=1.5.7
ZSTD_URL="https://github.com/facebook/zstd/releases/download/v${ZSTD_VERSION}/zstd-${ZSTD_VERSION}.tar.gz"
ZSTD_SHA256=eb33e51f49a15e023950cd7825ca74a4a2b43db8354825ac24fc1b7ee09e6fa3

# Linux only: macOS provides zlib, libedit (+ ncurses) and libuuid as system
# libraries, so they are linked dynamically from the OS there.
ZLIB_VERSION=1.4
ZLIB_URL="https://github.com/madler/zlib/releases/download/v${ZLIB_VERSION}/zlib-${ZLIB_VERSION}.tar.gz"
ZLIB_SHA256=02dd159783677a749c04adbdd02b55b8a2bcc7e054f51b76b549199a916ad584

# libedit (BSD licence) rather than GNU readline (GPLv3) for psql line editing,
# so bundling it statically does not change the licence of psql.
LIBEDIT_VERSION=20260512-3.1
LIBEDIT_URL="https://thrysoee.dk/editline/libedit-${LIBEDIT_VERSION}.tar.gz"
LIBEDIT_SHA256=432d5e7ea8b0116dd39f2eca7bc11d0eed77faa6b77ea526ace89907c23ea4a0

# libedit's termcap/terminfo backend.
NCURSES_VERSION=6.6
# ftp.gnu.org is often unreachable from CI runners: try the GNU mirror
# redirector first, and the maintainer's own archive last.
NCURSES_URL="https://ftpmirror.gnu.org/gnu/ncurses/ncurses-${NCURSES_VERSION}.tar.gz https://ftp.gnu.org/gnu/ncurses/ncurses-${NCURSES_VERSION}.tar.gz https://invisible-mirror.net/archives/ncurses/ncurses-${NCURSES_VERSION}.tar.gz"
NCURSES_SHA256=355b4cbbed880b0381a04c46617b7656e362585d52e9cf84a67e2009b749ff11

# libuuid (pg_clickhouse's HTTP driver uses uuid_generate for query ids).
UTIL_LINUX_VERSION=2.42.4
# Two kernel.org CDNs; build.sh tries each URL in a _URL list in turn.
UTIL_LINUX_URL="https://cdn.kernel.org/pub/linux/utils/util-linux/v2.42/util-linux-${UTIL_LINUX_VERSION}.tar.xz https://mirrors.edge.kernel.org/pub/linux/utils/util-linux/v2.42/util-linux-${UTIL_LINUX_VERSION}.tar.xz"
UTIL_LINUX_SHA256=fbd62a100ab7bb8746ba0661255c3c48185b1e9021507c624da01fbc696330ec

# musl (-unknown-linux-musl bundles only). The bundle ships the Alpine build
# image's own musl dynamic loader (lib/ld-musl-<arch>.so.1); build.sh checks
# that its version is MUSL_VERSION. The source tarball is only used for the
# licence file. musl publishes GPG signatures, not hashes.
MUSL_VERSION=1.2.6
MUSL_URL="https://musl.libc.org/releases/musl-${MUSL_VERSION}.tar.gz"
MUSL_SHA256=d585fd3b613c66151fc3249e8ed44f77020cb5e6c1e635a616d3f9f82460512a

# Linux build images are pinned by digest in build-linux.sh.
