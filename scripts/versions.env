# Pinned sources for pg-bundles. Sourced by scripts/build.sh (bash).
#
# Every source is pinned by version AND sha256. build.sh refuses to use a
# download whose hash does not match. When bumping a version, download the new
# file, check it against the upstream-published hash where one exists
# (PostgreSQL, OpenSSL, zstd, lz4, util-linux publish .sha256 files; curl,
# zlib, ncurses publish GPG signatures), and update both lines together.
#
# Format: <NAME>_VERSION, <NAME>_URL, <NAME>_SHA256.

# PostgreSQL 18, latest minor (checked 2026-10-15 on ftp.postgresql.org).
PG_VERSION=18.6
PG_URL="https://ftp.postgresql.org/pub/source/v${PG_VERSION}/postgresql-${PG_VERSION}.tar.bz2"
PG_SHA256=555610c24d53e4316da5b7d3fc25c279d96856d5e0e23ee308c328c5fa881d9f

# pg_clickhouse, latest release tag (release zip includes the vendored
# pg-clickhouse-c / clickhouse-c submodules).
PGCH_VERSION=0.11.0
PGCH_URL="https://github.com/ClickHouse/pg_clickhouse/releases/download/v${PGCH_VERSION}/pg_clickhouse-${PGCH_VERSION}.zip"
PGCH_SHA256=4df03bfd879355b560be0a25e64bd9beaa13829cfe272ffd4df66a32e57754c8

# OpenSSL 3.5 is the current 3.x LTS (supported to 2030). 3.6.x is newer but
# goes EOL in 2026-11; 4.x is a new major and not targeted here.
OPENSSL_VERSION=3.5.9
OPENSSL_URL="https://github.com/openssl/openssl/releases/download/openssl-${OPENSSL_VERSION}/openssl-${OPENSSL_VERSION}.tar.gz"
OPENSSL_SHA256=603f5602e2eef00d77fbd429d34dcd5822bb301757a1bc9cdb24c670f1eb859a

CURL_VERSION=8.23.0
CURL_URL="https://curl.se/download/curl-${CURL_VERSION}.tar.xz"
CURL_SHA256=8dadd7d2536a314f982ad05a651b713f426bf7d02cc2c76cffb9796f2218e6c5

LZ4_VERSION=1.10.0
LZ4_URL="https://github.com/lz4/lz4/releases/download/v${LZ4_VERSION}/lz4-${LZ4_VERSION}.tar.gz"
LZ4_SHA256=537512904744b35e232912055ccf8ec66d768639ff3abe5788d90d792ec5f48b

ZSTD_VERSION=1.5.7
ZSTD_URL="https://github.com/facebook/zstd/releases/download/v${ZSTD_VERSION}/zstd-${ZSTD_VERSION}.tar.gz"
ZSTD_SHA256=eb33e51f49a15e023950cd7825ca74a4a2b43db8354825ac24fc1b7ee09e6fa3

# Linux only: macOS provides zlib, libedit (+ ncurses) and libuuid as system
# libraries, so they are linked dynamically from the OS there.
ZLIB_VERSION=1.3.2
ZLIB_URL="https://github.com/madler/zlib/releases/download/v${ZLIB_VERSION}/zlib-${ZLIB_VERSION}.tar.gz"
ZLIB_SHA256=bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16

# libedit (BSD licence) rather than GNU readline (GPLv3) for psql line editing,
# so bundling it statically does not change the licence of psql.
LIBEDIT_VERSION=20260512-3.1
LIBEDIT_URL="https://thrysoee.dk/editline/libedit-${LIBEDIT_VERSION}.tar.gz"
LIBEDIT_SHA256=432d5e7ea8b0116dd39f2eca7bc11d0eed77faa6b77ea526ace89907c23ea4a0

# libedit's termcap/terminfo backend.
NCURSES_VERSION=6.6
NCURSES_URL="https://ftp.gnu.org/gnu/ncurses/ncurses-${NCURSES_VERSION}.tar.gz"
NCURSES_SHA256=355b4cbbed880b0381a04c46617b7656e362585d52e9cf84a67e2009b749ff11

# libuuid (pg_clickhouse's HTTP driver uses uuid_generate for query ids).
UTIL_LINUX_VERSION=2.42.4
UTIL_LINUX_URL="https://mirrors.edge.kernel.org/pub/linux/utils/util-linux/v2.42/util-linux-${UTIL_LINUX_VERSION}.tar.xz"
UTIL_LINUX_SHA256=fbd62a100ab7bb8746ba0661255c3c48185b1e9021507c624da01fbc696330ec

# Linux build image (glibc 2.28 baseline). Pinned by digest in build-linux.sh.
